<%- include('../partials/header', { title: tournament.name, user: typeof user !== 'undefined' ? user : null, flash: typeof flash !== 'undefined' ? flash : null }) %>

<div class="container">
  <div class="page-header page-header-with-action">
    <div>
      <h1>🏓 <%= tournament.name %></h1>
      <p class="text-muted">
        <% if (tournament.event_date) { %>📅 <%= tournament.event_date %> · <% } %>
        <span class="badge badge-<%= tournament.status %>"><%= tournament.status %></span>
      </p>
    </div>
    <a href="/tournament" class="btn btn-outline btn-sm">← Danh sách giải đấu</a>
  </div>

  <% if (groups.length > 0) { %>
    <h2 class="section-title">Bảng đấu &amp; lịch thi đấu</h2>
    <div class="tournament-groups-grid">
      <% groups.forEach(function(g) { %>
        <div class="group-card">
          <div class="group-card-header">Bảng <%= g.group_label %></div>
          <div class="group-card-body">
            <% g.members.forEach(function(m) { %>
              <div class="group-seed-row">
                <span class="group-seed-badge"><%= m.group_seed %></span>
                <img src="/avatars/<%= m.avatar %>" class="admin-table-avatar" alt="">
                <span><%= m.full_name %></span>
                <span class="text-muted text-sm" style="margin-left:auto"><%= m.total_points %> điểm</span>
              </div>
            <% }); %>
          </div>
          <div class="group-card-body" style="border-top:1px solid var(--line)">
            <% g.matches.forEach(function(m) { %>
              <div class="result-match-card" style="margin-bottom:0.75rem">
                <div class="match-row">
                  <div class="match-team-side">
                    <span class="match-team-name"><%= m.a1_name %> &amp; <%= m.a2_name %></span>
                    <% if (m.status === 'completed') { %><span class="match-team-score"><%= m.score_a %></span><% } %>
                  </div>
                  <div class="match-center">
                    <span class="badge badge-<%= m.status %>"><%= m.status === 'completed' ? 'Xong' : 'Chưa đấu' %></span>
                  </div>
                  <div class="match-team-side match-team-right">
                    <% if (m.status === 'completed') { %><span class="match-team-score"><%= m.score_b %></span><% } %>
                    <span class="match-team-name"><%= m.b1_name %> &amp; <%= m.b2_name %></span>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <% if (finalMatch) { %>
    <h2 class="section-title">Chung kết &amp; tranh hạng 5</h2>
    <div class="result-match-card final-match-card">
      <div class="match-row">
        <div class="match-team-side <%= finalMatch.status === 'completed' && finalMatch.score_a >= finalMatch.score_b ? 'match-team-winner' : '' %>">
          <span class="match-team-name"><%= finalMatch.a1_name %> &amp; <%= finalMatch.a2_name %></span>
          <% if (finalMatch.status === 'completed') { %><span class="match-team-score"><%= finalMatch.score_a %></span><% } %>
        </div>
        <div class="match-center"><span class="match-reward">🏆 Chung kết</span></div>
        <div class="match-team-side match-team-right <%= finalMatch.status === 'completed' && finalMatch.score_b > finalMatch.score_a ? 'match-team-winner' : '' %>">
          <% if (finalMatch.status === 'completed') { %><span class="match-team-score"><%= finalMatch.score_b %></span><% } %>
          <span class="match-team-name"><%= finalMatch.b1_name %> &amp; <%= finalMatch.b2_name %></span>
        </div>
      </div>
    </div>
    <% if (consolationMatch) { %>
      <div class="result-match-card final-match-card" style="margin-top:1rem">
        <div class="match-row">
          <div class="match-team-side <%= consolationMatch.status === 'completed' && consolationMatch.score_a >= consolationMatch.score_b ? 'match-team-winner' : '' %>">
            <span class="match-team-name"><%= consolationMatch.a1_name %> &amp; <%= consolationMatch.a2_name %></span>
            <% if (consolationMatch.status === 'completed') { %><span class="match-team-score"><%= consolationMatch.score_a %></span><% } %>
          </div>
          <div class="match-center"><span class="match-reward">🥉 Tranh hạng 5</span></div>
          <div class="match-team-side match-team-right <%= consolationMatch.status === 'completed' && consolationMatch.score_b > consolationMatch.score_a ? 'match-team-winner' : '' %>">
            <% if (consolationMatch.status === 'completed') { %><span class="match-team-score"><%= consolationMatch.score_b %></span><% } %>
            <span class="match-team-name"><%= consolationMatch.b1_name %> &amp; <%= consolationMatch.b2_name %></span>
          </div>
        </div>
      </div>
    <% } %>
  <% } %>

  <h2 class="section-title" style="margin-top:2rem">Bảng xếp hạng<%= tournament.status === 'completed' ? ' chung cuộc' : ' trực tiếp' %></h2>
  <div class="leaderboard-table-wrapper">
    <table class="leaderboard-table">
      <thead>
        <tr>
          <th class="col-rank">Hạng</th>
          <th></th>
          <th>Thành viên</th>
          <th class="col-stat">Điểm cá nhân</th>
          <th class="col-stat">Hiệu số</th>
        </tr>
      </thead>
      <tbody>
        <% standings.forEach(function(s, i) { %>
          <tr class="<%= i < 3 ? 'top-' + (i + 1) : '' %>">
            <td class="col-rank">
              <% if (i < 3) { %>
                <span class="rank-medal"><%= String(s.final_rank || i + 1).padStart(2, '0') %></span>
              <% } else { %>
                <span class="rank-number"><%= String(s.final_rank || i + 1).padStart(2, '0') %></span>
              <% } %>
            </td>
            <td><img src="/avatars/<%= s.avatar %>" class="admin-table-avatar" alt=""></td>
            <td>
              <strong><%= s.full_name %></strong>
              <span class="text-muted text-sm"> @<%= s.username %></span>
            </td>
            <td class="col-stat"><%= s.total_points %></td>
            <td class="col-stat"><%= s.points_diff > 0 ? '+' + s.points_diff : s.points_diff %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
