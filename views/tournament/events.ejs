<%- include('../partials/header', { title: 'Thông tin giải đấu', user: typeof user !== 'undefined' ? user : null, flash: typeof flash !== 'undefined' ? flash : null }) %>

<div class="container">
  <div class="page-header">
    <h1>🏅 Thông tin giải đấu</h1>
    <p class="text-muted">Các giải đấu của CLB</p>
  </div>

  <% if (events.length > 0) { %>
    <div class="teams-list">
      <% events.forEach(function(e) { %>
        <a href="/tournament/events/<%= e.id %>" class="team-card">
          <div class="team-card-header">
            <h3 class="team-name"><%= e.name %></h3>
            <span class="badge badge-<%= e.status %>"><%= statusLabels[e.status] || e.status %></span>
          </div>
          <div class="team-card-body">
            <p class="text-muted text-sm">
              <% if (e.event_date) { %>📅 <%= e.event_date.split('-').reverse().join('/') %> <% if (e.event_time) { %><%= e.event_time %><% } %> · <% } %>
              <% if (e.location) { %>📍 <%= e.location %> · <% } %>
              👥 <%= e.team_count %> đội
            </p>
          </div>
        </a>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <p>Chưa có thông tin giải đấu nào.</p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
