<%- include('partials/header', { title: 'Trang chủ', user: typeof user !== 'undefined' ? user : null, flash: typeof flash !== 'undefined' ? flash : null }) %>

<section class="hero">
  <div class="hero-decor" aria-hidden="true">
    <div class="hero-ball hero-ball-1"></div>
    <div class="hero-ball hero-ball-2"></div>
    <div class="hero-ball hero-ball-3"></div>
    <div class="hero-ball hero-ball-4"></div>
  </div>
  <div class="hero-avatars" aria-hidden="true">
    <% if (typeof members !== 'undefined') { members.forEach(function(m, i) { %>
      <div class="hero-avatar-bubble" style="--i:<%= i %>; --total:<%= members.length %>">
        <img src="/avatars/<%= m.avatar %>" alt="<%= m.full_name %>" title="<%= m.full_name %>">
      </div>
    <% }); } %>
  </div>
  <div class="hero-content">
    <p class="hero-subtitle">5:30 – 7:00 hàng ngày · DinkZone · Vĩnh Tuy</p>
    <h1 class="hero-title">
      PICKLEBALL <span class="hero-accent">CLUB</span>
      <span class="hero-title-line2">VUI CẢ TUẦN <span class="hero-accent-orange">Breakfast</span></span>
    </h1>
    <p class="hero-tagline">Trúng thì nở mày nở mặt, trật thì... bao bữa sáng.</p>
    <div class="hero-actions">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/challenges/create" class="btn btn-accent btn-lg"><span>Tạo thách đấu</span></a>
        <a href="/leaderboard" class="btn btn-outline-light btn-lg"><span>Bảng xếp hạng</span></a>
      <% } else { %>
        <a href="/login" class="btn btn-accent btn-lg"><span>Đăng nhập</span></a>
      <% } %>
    </div>
  </div>
</section>

<% if (typeof scheduledMatches !== 'undefined' && scheduledMatches.length > 0) { %>
<div class="ticker-wrap">
  <div class="ticker-label">Diễn biến</div>
  <div class="ticker-track">
    <div class="ticker-content">
      <% for (var rep = 0; rep < 2; rep++) { scheduledMatches.forEach(function(m) { %>
        <span class="ticker-item">
          <% if (m.status === 'completed' && m.winner_name) { %>
            <strong><%= m.winner_name %></strong> thắng — <%= m.challenger_name %> vs <%= m.challenged_name %> · <%= m.reward %>
          <% } else if (m.status === 'scheduled') { %>
            <strong><%= m.challenger_name %></strong> vs <strong><%= m.challenged_name %></strong> · <%= m.match_date.split('-').reverse().join('/') %> <%= m.match_time %> · <%= m.reward %>
          <% } else { %>
            <%= m.challenger_name %> vs <%= m.challenged_name %> · <%= m.status %>
          <% } %>
        </span>
        <span class="ticker-sep">◆</span>
      <% }); } %>
    </div>
  </div>
</div>
<% } %>

<section class="section">
  <div class="container">
    <div class="info-cards">
      <div class="info-card">
        <h3>Lịch chơi</h3>
        <p class="info-card-value">5:30 - 7:00</p>
        <p class="info-card-label">Hàng ngày</p>
      </div>
      <div class="info-card">
        <h3>Địa điểm</h3>
        <p class="info-card-value">DinkZone</p>
        <p class="info-card-label">
          <a href="https://maps.app.goo.gl/4tEsbBoutoE3B9cSA" target="_blank" rel="noopener">
            64 ngõ 124 Vĩnh Tuy &rarr;
          </a>
        </p>
      </div>
      <div class="info-card">
        <h3>Thành viên</h3>
        <p class="info-card-value" data-countup="<%= typeof memberCount !== 'undefined' ? memberCount : 0 %>"><%= typeof memberCount !== 'undefined' ? memberCount : 0 %></p>
        <p class="info-card-label">Người chơi</p>
      </div>
      <div class="info-card info-card-fund">
        <h3>Quỹ bữa sáng</h3>
        <p class="info-card-value" data-countup="<%= typeof totalFund !== 'undefined' ? totalFund : 0 %>"><%= typeof totalFund !== 'undefined' ? totalFund : 0 %></p>
        <p class="info-card-label"><a href="/leaderboard">Xem chi tiết →</a></p>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <h2 class="section-title">Trận đấu gần đây</h2>
    <% if (typeof recentChallenges !== 'undefined' && recentChallenges.length > 0) { %>
      <div class="challenge-list">
        <% recentChallenges.forEach(function(c) {
          // Parse scores: assume "winner-loser" format (first number = winner's score)
          var challengerScore = '', challengedScore = '';
          if (c.scores && c.winner_name) {
            var parts = c.scores.trim().split('-');
            if (parts.length === 2) {
              var winnerS = parts[0].trim(), loserS = parts[1].trim();
              if (c.winner_name === c.challenger_name) {
                challengerScore = winnerS; challengedScore = loserS;
              } else {
                challengerScore = loserS; challengedScore = winnerS;
              }
            }
          }
        %>
          <a href="/challenges/<%= c.id %>" class="challenge-card-mini">
            <div class="match-row">
              <div class="match-team-side <%= c.winner_name === c.challenger_name ? 'match-team-winner' : '' %>">
                <div class="match-team-avatars">
                  <% c.challenger_members.forEach(function(m) { %>
                    <img src="/avatars/<%= m.avatar %>" alt="<%= m.full_name %>" title="<%= m.full_name %>" class="match-avatar">
                  <% }); %>
                </div>
                <span class="match-team-name"><%= c.winner_name === c.challenger_name ? '🏆 ' : '' %><%= c.challenger_name %></span>
                <% if (challengerScore) { %><span class="match-team-score"><%= challengerScore %></span><% } %>
              </div>
              <div class="match-center">
                <% if (c.status === 'completed') { %>
                  <span class="badge badge-completed">Hoàn thành</span>
                <% } else { %>
                  <span class="badge badge-scheduled">Đã lên lịch</span>
                <% } %>
                <% if (c.challenge_type === 'singles') { %><span class="badge badge-singles" style="font-size:0.65rem">Đơn</span><% } %>
                <span class="match-date"><%= c.match_date.split('-').reverse().join('/') %></span>
                <span class="match-reward">🍜 <%= c.reward %></span>
              </div>
              <div class="match-team-side match-team-right <%= c.winner_name === c.challenged_name ? 'match-team-winner' : '' %>">
                <% if (challengedScore) { %><span class="match-team-score"><%= challengedScore %></span><% } %>
                <div class="match-team-avatars">
                  <% c.challenged_members.forEach(function(m) { %>
                    <img src="/avatars/<%= m.avatar %>" alt="<%= m.full_name %>" title="<%= m.full_name %>" class="match-avatar">
                  <% }); %>
                </div>
                <span class="match-team-name"><%= c.winner_name === c.challenged_name ? '🏆 ' : '' %><%= c.challenged_name %></span>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
      <div class="text-center mt-2">
        <a href="/challenges" class="btn btn-outline"><span>Xem tất cả</span></a>
      </div>
    <% } else { %>
      <p class="text-muted text-center">Chưa có trận đấu nào. Hãy tạo thách đấu đầu tiên!</p>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">Thống kê nhanh</h2>
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-value stat-color-1" data-countup="<%= typeof stats !== 'undefined' ? stats.totalMatches : 0 %>"><%= typeof stats !== 'undefined' ? stats.totalMatches : 0 %></div>
        <div class="stat-label">Trận đấu</div>
      </div>
      <div class="stat-card">
        <div class="stat-value stat-color-2" data-countup="<%= typeof stats !== 'undefined' ? stats.totalTeams : 0 %>"><%= typeof stats !== 'undefined' ? stats.totalTeams : 0 %></div>
        <div class="stat-label">Đội</div>
      </div>
      <div class="stat-card">
        <div class="stat-value stat-color-3" data-countup="<%= typeof stats !== 'undefined' ? stats.breakfastsWon : 0 %>"><%= typeof stats !== 'undefined' ? stats.breakfastsWon : 0 %></div>
        <div class="stat-label">Bữa sáng đã cược</div>
      </div>
      <div class="stat-card">
        <div class="stat-value stat-color-4" data-countup="<%= typeof stats !== 'undefined' ? stats.activeChallenges : 0 %>"><%= typeof stats !== 'undefined' ? stats.activeChallenges : 0 %></div>
        <div class="stat-label">Đang thách đấu</div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
