<%- include('partials/header', { title: 'Thành viên', user: typeof user !== 'undefined' ? user : null, flash: typeof flash !== 'undefined' ? flash : null }) %>

<div class="container">
  <div class="page-header">
    <h1>Thành viên</h1>
    <p class="text-muted">Danh sách thành viên CLB Pickleball Vui cả tuần</p>
  </div>

  <% if (typeof members !== 'undefined' && members.length > 0) { %>
    <div class="members-grid">
      <% members.forEach(function(member) { %>
        <a href="/members/<%= member.username %>" class="member-card">
          <img src="/avatars/<%= member.avatar || 'default.png' %>" alt="<%= member.full_name %>" class="member-avatar">
          <h3 class="member-name"><%= member.full_name %></h3>
          <p class="member-username">@<%= member.username %></p>
        </a>
      <% }); %>
    </div>
  <% } else { %>
    <p class="text-muted text-center">Chưa có thành viên nào.</p>
  <% } %>
</div>

<%- include('partials/footer') %>
