<%- include('../partials/header', { title: 'Tạo thách đấu', user: typeof user !== 'undefined' ? user : null, flash: typeof flash !== 'undefined' ? flash : null }) %>

<div class="container">
  <div class="page-header">
    <h1>Tạo thách đấu</h1>
    <p class="text-muted">Chọn loại trận và cược bữa sáng!</p>
  </div>

  <div class="form-card">
    <div class="challenge-type-toggle">
      <button type="button" class="btn btn-primary" id="btnDoubles" onclick="setChallengeType('doubles')">Đôi</button>
      <button type="button" class="btn btn-outline" id="btnSingles" onclick="setChallengeType('singles')">Đơn</button>
    </div>

    <form action="/challenges/create" method="POST" id="createChallengeForm">
      <input type="hidden" name="challenge_type" id="challengeType" value="doubles">

      <div id="doublesFields">
        <div class="form-group">
          <label for="challengerTeam" class="form-label">Đội thách đấu</label>
          <select id="challengerTeam" name="challenger_team_id" class="form-input" required>
            <option value="">-- Chọn đội --</option>
            <% if (typeof teams !== 'undefined') { teams.forEach(function(t) { %>
              <option value="<%= t.id %>"><%= t.name %> (<%= t.member_names %>)</option>
            <% }); } %>
          </select>
        </div>

        <div class="vs-divider">VS</div>

        <div class="form-group">
          <label for="challengedTeam" class="form-label">Đội bị thách đấu</label>
          <select id="challengedTeam" name="challenged_team_id" class="form-input" required>
            <option value="">-- Chọn đội --</option>
            <% if (typeof teams !== 'undefined') { teams.forEach(function(t) { %>
              <option value="<%= t.id %>"><%= t.name %> (<%= t.member_names %>)</option>
            <% }); } %>
          </select>
        </div>
      </div>

      <div id="singlesFields" style="display:none">
        <div class="form-group">
          <label for="challengerUser" class="form-label">Người thách đấu</label>
          <select id="challengerUser" name="challenger_user_id" class="form-input">
            <option value="">-- Chọn người chơi --</option>
            <% if (typeof users !== 'undefined') { users.forEach(function(u) { %>
              <option value="<%= u.id %>"><%= u.full_name %></option>
            <% }); } %>
          </select>
        </div>

        <div class="vs-divider">VS</div>

        <div class="form-group">
          <label for="challengedUser" class="form-label">Người bị thách đấu</label>
          <select id="challengedUser" name="challenged_user_id" class="form-input">
            <option value="">-- Chọn người chơi --</option>
            <% if (typeof users !== 'undefined') { users.forEach(function(u) { %>
              <option value="<%= u.id %>"><%= u.full_name %></option>
            <% }); } %>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group form-group-half">
          <label for="challengeDate" class="form-label">Ngày</label>
          <input type="date" id="challengeDate" name="match_date" class="form-input" required>
        </div>
        <div class="form-group form-group-half">
          <label for="challengeTime" class="form-label">Giờ</label>
          <input type="time" id="challengeTime" name="match_time" class="form-input" value="05:30" required>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Kèo bữa sáng</label>
        <div class="reward-options">
          <label class="reward-option">
            <input type="radio" name="reward" value="Phở bò" checked>
            <span class="reward-card">🍜 Phở bò</span>
          </label>
          <label class="reward-option">
            <input type="radio" name="reward" value="Bánh mì chảo">
            <span class="reward-card">🍳 Bánh mì chảo</span>
          </label>
          <label class="reward-option">
            <input type="radio" name="reward" value="Bún chả">
            <span class="reward-card">🥢 Bún chả</span>
          </label>
          <label class="reward-option">
            <input type="radio" name="reward" value="Cơm rang">
            <span class="reward-card">🍚 Cơm rang</span>
          </label>
          <label class="reward-option">
            <input type="radio" name="reward" value="custom" id="rewardCustomRadio">
            <span class="reward-card">✏️ Tự chọn</span>
          </label>
        </div>
        <input type="text" name="reward_detail" id="customReward" class="form-input mt-1" placeholder="Nhập phần thưởng tùy chọn..." style="display:none">
      </div>

      <div class="form-actions">
        <a href="/challenges" class="btn btn-outline">Hủy</a>
        <button type="submit" class="btn btn-primary">Gửi thách đấu</button>
      </div>
    </form>
  </div>
</div>

<style>
.vs-divider {
  text-align: center;
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--primary);
  margin: 0.5rem 0;
  letter-spacing: 2px;
}
</style>

<script>
function setChallengeType(type) {
  document.getElementById('challengeType').value = type;
  var isDoubles = type === 'doubles';
  document.getElementById('doublesFields').style.display = isDoubles ? '' : 'none';
  document.getElementById('singlesFields').style.display = isDoubles ? 'none' : '';
  document.getElementById('btnDoubles').className = isDoubles ? 'btn btn-primary' : 'btn btn-outline';
  document.getElementById('btnSingles').className = isDoubles ? 'btn btn-outline' : 'btn btn-primary';
  document.getElementById('challengerTeam').required = isDoubles;
  document.getElementById('challengedTeam').required = isDoubles;
  document.getElementById('challengerUser').required = !isDoubles;
  document.getElementById('challengedUser').required = !isDoubles;
}

document.getElementById('challengerTeam').addEventListener('change', function() {
  var val = this.value;
  var opts = document.getElementById('challengedTeam').options;
  for (var i = 0; i < opts.length; i++) {
    opts[i].disabled = (opts[i].value === val && val !== '');
  }
});

document.getElementById('challengerUser').addEventListener('change', function() {
  var val = this.value;
  var opts = document.getElementById('challengedUser').options;
  for (var i = 0; i < opts.length; i++) {
    opts[i].disabled = (opts[i].value === val && val !== '');
  }
});
</script>

<%- include('../partials/footer') %>
