<%- include('../../partials/header', { title: 'Chung kết - ' + tournament.name, user: typeof user !== 'undefined' ? user : null, flash: typeof flash !== 'undefined' ? flash : null }) %>

<div class="container">
  <div class="page-header page-header-with-action">
    <div>
      <h1>🏆 Chung kết — <%= tournament.name %></h1>
    </div>
    <div>
      <a href="/admin/tournament/<%= tournament.id %>/export" class="btn btn-outline btn-sm">📊 Xuất Excel</a>
      <a href="/admin/tournament" class="btn btn-outline btn-sm">← Quản lý giải đấu</a>
    </div>
  </div>

  <% if (!finalMatch) { %>
    <div class="empty-state">
      <p>Chưa tạo trận chung kết. Hãy nhập đủ kết quả vòng bảng trước.</p>
      <a href="/admin/tournament/<%= tournament.id %>/matches" class="btn btn-primary">Về vòng bảng</a>
    </div>
  <% } else { %>
    <% [['final', finalMatch, '🏆 Chung kết'], ['consolation', consolationMatch, '🥉 Tranh hạng 5']].forEach(function(pair) {
      var m = pair[1];
      if (!m) return;
    %>
      <h2 class="section-title"><%= pair[2] %></h2>
      <div class="admin-match-card final-match-card">
        <div class="admin-match-teams">
          <div class="admin-match-team"><h3><%= m.a1_name %> &amp; <%= m.a2_name %></h3></div>
          <div class="admin-match-vs">
            <span class="vs-big">VS</span>
            <span class="badge badge-<%= m.status %>"><%= m.status === 'completed' ? 'Đã xong' : 'Chưa đấu' %></span>
          </div>
          <div class="admin-match-team"><h3><%= m.b1_name %> &amp; <%= m.b2_name %></h3></div>
        </div>

        <% if (m.status === 'completed') { %>
          <p style="text-align:center;margin-top:1rem;font-size:1.3rem;font-weight:700"><%= m.score_a %> - <%= m.score_b %></p>
        <% } else { %>
          <form action="/admin/tournament/<%= tournament.id %>/final/<%= m.id %>/score" method="POST" style="display:flex;gap:0.75rem;align-items:flex-end;justify-content:center;margin-top:1rem">
            <div class="form-group" style="margin-bottom:0">
              <label class="form-label">Điểm đội 1</label>
              <input type="number" name="score_a" class="form-input" min="0" max="15" required style="max-width:100px">
            </div>
            <div class="form-group" style="margin-bottom:0">
              <label class="form-label">Điểm đội 2</label>
              <input type="number" name="score_b" class="form-input" min="0" max="15" required style="max-width:100px">
            </div>
            <button type="submit" class="btn btn-primary">Lưu kết quả</button>
          </form>
        <% } %>
      </div>
    <% }); %>
  <% } %>

  <h2 class="section-title" style="margin-top:2rem">Bảng xếp hạng<%= tournament.status === 'completed' ? ' chung cuộc' : ' trực tiếp' %></h2>
  <div class="leaderboard-table-wrapper">
    <table class="leaderboard-table">
      <thead>
        <tr>
          <th class="col-rank">Hạng</th>
          <th></th>
          <th>Thành viên</th>
          <th class="col-stat">Điểm cá nhân</th>
          <th class="col-stat">Hiệu số</th>
        </tr>
      </thead>
      <tbody>
        <% standings.forEach(function(s, i) { %>
          <tr class="<%= i < 3 ? 'top-' + (i + 1) : '' %>">
            <td class="col-rank">
              <% if (i < 3) { %>
                <span class="rank-medal"><%= String(s.final_rank || i + 1).padStart(2, '0') %></span>
              <% } else { %>
                <span class="rank-number"><%= String(s.final_rank || i + 1).padStart(2, '0') %></span>
              <% } %>
            </td>
            <td><img src="/avatars/<%= s.avatar %>" class="admin-table-avatar" alt=""></td>
            <td>
              <strong><%= s.full_name %></strong>
              <span class="text-muted text-sm"> @<%= s.username %></span>
            </td>
            <td class="col-stat"><%= s.total_points %></td>
            <td class="col-stat"><%= s.points_diff > 0 ? '+' + s.points_diff : s.points_diff %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/footer') %>
