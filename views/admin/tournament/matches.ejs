<%
  var allGroupMatchesDone = groups.every(function(g) {
    return g.matches.every(function(m) { return m.status === 'completed'; });
  });
%>
<%- include('../../partials/header', { title: 'Vòng bảng - ' + tournament.name, user: typeof user !== 'undefined' ? user : null, flash: typeof flash !== 'undefined' ? flash : null }) %>

<div class="container">
  <div class="page-header page-header-with-action">
    <div>
      <h1>🏓 Vòng bảng — <%= tournament.name %></h1>
      <p class="text-muted">Nhập tỉ số từng trận. Điểm cá nhân cộng dồn tự động sau khi lưu.</p>
    </div>
    <div>
      <a href="/admin/tournament/<%= tournament.id %>/export" class="btn btn-outline btn-sm">📊 Xuất Excel</a>
      <a href="/admin/tournament" class="btn btn-outline btn-sm">← Quản lý giải đấu</a>
    </div>
  </div>

  <% groups.forEach(function(g) { %>
    <h2 class="section-title">Bảng <%= g.group_label %></h2>
    <% g.matches.forEach(function(m) { %>
      <div class="admin-match-card">
        <div class="admin-match-teams">
          <div class="admin-match-team">
            <h3><%= m.a1_name %> &amp; <%= m.a2_name %></h3>
          </div>
          <div class="admin-match-vs">
            <span class="vs-big">VS</span>
            <span class="badge badge-<%= m.status %>"><%= m.status === 'completed' ? 'Đã xong' : 'Chưa đấu' %></span>
          </div>
          <div class="admin-match-team">
            <h3><%= m.b1_name %> &amp; <%= m.b2_name %></h3>
          </div>
        </div>

        <% if (m.status === 'completed') { %>
          <p style="text-align:center;margin-top:1rem;font-size:1.3rem;font-weight:700">
            <%= m.score_a %> - <%= m.score_b %>
          </p>
        <% } else { %>
          <form action="/admin/tournament/<%= tournament.id %>/matches/<%= m.id %>/score" method="POST" style="display:flex;gap:0.75rem;align-items:flex-end;justify-content:center;margin-top:1rem">
            <div class="form-group" style="margin-bottom:0">
              <label class="form-label">Điểm đội 1</label>
              <input type="number" name="score_a" class="form-input" min="0" max="15" required style="max-width:100px">
            </div>
            <div class="form-group" style="margin-bottom:0">
              <label class="form-label">Điểm đội 2</label>
              <input type="number" name="score_b" class="form-input" min="0" max="15" required style="max-width:100px">
            </div>
            <button type="submit" class="btn btn-primary">Lưu kết quả</button>
          </form>
        <% } %>
      </div>
    <% }); %>
  <% }); %>

  <% if (allGroupMatchesDone && !finalMatch) { %>
    <div class="form-actions" style="margin-top:1.5rem">
      <form action="/admin/tournament/<%= tournament.id %>/finalize-groups" method="POST">
        <button type="submit" class="btn btn-primary" onclick="return confirm('Chốt vòng bảng và tạo trận chung kết?')">Chốt vòng bảng &amp; tạo chung kết</button>
      </form>
    </div>
  <% } else if (finalMatch) { %>
    <div class="alert alert-info" style="margin-top:1.5rem"><a href="/admin/tournament/<%= tournament.id %>/final">Đi tới trận chung kết →</a></div>
  <% } %>
</div>

<%- include('../../partials/footer') %>
