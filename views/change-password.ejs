<%- include('partials/header', { title: 'Đổi mật khẩu', user: typeof user !== 'undefined' ? user : null, flash: typeof flash !== 'undefined' ? flash : null }) %>

<div class="container">
  <div class="page-header">
    <h1>Đổi mật khẩu</h1>
  </div>

  <div class="form-card" style="max-width:480px">
    <% if (error) { %>
      <div class="alert alert-warning" style="margin-bottom:1rem"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="alert alert-success" style="margin-bottom:1rem"><%= success %></div>
    <% } %>

    <form action="/change-password" method="POST">
      <div class="form-group">
        <label class="form-label">Mật khẩu hiện tại</label>
        <input type="password" name="current_password" class="form-input" required>
      </div>
      <div class="form-group">
        <label class="form-label">Mật khẩu mới</label>
        <input type="password" name="new_password" class="form-input" required minlength="4">
      </div>
      <div class="form-group">
        <label class="form-label">Xác nhận mật khẩu mới</label>
        <input type="password" name="confirm_password" class="form-input" required minlength="4">
      </div>
      <div class="form-actions">
        <a href="/" class="btn btn-outline">Hủy</a>
        <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
